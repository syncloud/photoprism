new file mode 100644
index 0000000..1313d50
--- /dev/null
+++ b/internal/entity/auth_session_login_ldap.go
@@ -0,0 +1,78 @@
+package entity
+
+import (
+	"os"
+	"strings"
+
+	"github.com/go-ldap/ldap/v3"
+
+	"github.com/photoprism/photoprism/internal/auth/acl"
+	"github.com/photoprism/photoprism/pkg/clean"
+	"github.com/photoprism/photoprism/pkg/rnd"
+)
+
+var LdapBind = func(username, password string) (admin bool, err error) {
+	conn, err := ldap.DialURL(os.Getenv("PHOTOPRISM_LDAP_URI"))
+	if err != nil {
+		return false, err
+	}
+	defer conn.Close()
+
+	if err = conn.Bind(strings.ReplaceAll(os.Getenv("PHOTOPRISM_LDAP_BIND_DN"), "{username}", ldap.EscapeDN(username)), password); err != nil {
+		return false, err
+	}
+
+	result, err := conn.Search(ldap.NewSearchRequest(
+		os.Getenv("PHOTOPRISM_LDAP_ADMIN_GROUP_DN"),
+		ldap.ScopeBaseObject, ldap.NeverDerefAliases, 0, 0, false,
+		strings.ReplaceAll(os.Getenv("PHOTOPRISM_LDAP_ADMIN_GROUP_FILTER"), "{username}", ldap.EscapeFilter(username)),
+		[]string{"dn"},
+		nil,
+	))
+	if err != nil {
+		return false, err
+	}
+
+	return len(result.Entries) > 0, nil
+}
+
+func AuthLdap(userName, password string) *User {
+	if os.Getenv("PHOTOPRISM_LDAP_URI") == "" || userName == "" || password == "" || rnd.IsAppPassword(password, false) {
+		return nil
+	}
+
+	admin, err := LdapBind(userName, password)
+	if err != nil {
+		log.Debugf("ldap: %s did not sign in (%s)", clean.LogQuote(userName), clean.Error(err))
+		return nil
+	}
+
+	if user := FindUserByExactName(userName); user != nil {
+		if !user.CanLogIn() || !user.IsLdapAccount() {
+			return nil
+		}
+		return user
+	}
+
+	user := NewUser()
+	user.UserName = userName
+	user.CanLogin = true
+	user.WebDAV = true
+
+	if admin {
+		user.SuperAdmin = true
+		user.UserRole = acl.RoleAdmin.String()
+	} else {
+		user.UserRole = acl.RoleUser.String()
+		user.SetBasePath("~")
+	}
+
+	if err = user.Create(); err != nil {
+		log.Errorf("ldap: failed to add account %s (%s)", clean.LogQuote(userName), clean.Error(err))
+		return nil
+	}
+
+	log.Infof("ldap: added account %s", clean.LogQuote(userName))
+
+	return user
+}
