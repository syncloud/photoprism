+package entity
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/photoprism/photoprism/internal/auth/acl"
+	"github.com/photoprism/photoprism/internal/form"
+	"github.com/photoprism/photoprism/pkg/authn"
+)
+
+func useLdap(t *testing.T, directory *ldapDirectory) {
+	t.Setenv("PHOTOPRISM_LDAP_URI", "ldap://localhost:389")
+	bind := LdapBind
+	LdapBind = directory.bind
+	t.Cleanup(func() { LdapBind = bind })
+}
+
+func TestAuthLdap(t *testing.T) {
+	t.Run("AddsRegularUserWithOwnFolder", func(t *testing.T) {
+		useLdap(t, &ldapDirectory{passwords: map[string]string{"ldapfresh": "secret-1"}})
+
+		user, provider, _, err := Auth(form.Login{Username: "ldapfresh", Password: "secret-1"}, nil, nil)
+
+		require.NoError(t, err)
+		require.NotNil(t, user)
+		assert.Equal(t, authn.ProviderLDAP, provider)
+		assert.Equal(t, acl.RoleUser.String(), user.UserRole)
+		assert.Equal(t, "users/ldapfresh", user.BasePath)
+		assert.True(t, user.IsUnlinkedLdap())
+	})
+	t.Run("AddsAdminFromSyncloudGroup", func(t *testing.T) {
+		useLdap(t, &ldapDirectory{passwords: map[string]string{"ldapboss": "secret-2"}, admins: map[string]bool{"ldapboss": true}})
+
+		user, _, _, err := Auth(form.Login{Username: "ldapboss", Password: "secret-2"}, nil, nil)
+
+		require.NoError(t, err)
+		require.NotNil(t, user)
+		assert.True(t, user.SuperAdmin)
+		assert.Equal(t, acl.RoleAdmin.String(), user.UserRole)
+	})
+	t.Run("SignsInToAccountLinkedByOidc", func(t *testing.T) {
+		m := User{UserName: "ldapoidc", UserRole: acl.RoleUser.String(), CanLogin: true}
+		require.NoError(t, m.Create())
+		require.NoError(t, LinkLdapUser(oidcLogin("ldapoidc", "sub-ldapoidc")))
+		useLdap(t, &ldapDirectory{passwords: map[string]string{"ldapoidc": "secret-3"}})
+
+		user, _, _, err := Auth(form.Login{Username: "ldapoidc", Password: "secret-3"}, nil, nil)
+
+		require.NoError(t, err)
+		require.NotNil(t, user)
+		assert.Equal(t, m.UserUID, user.UserUID)
+		assert.Equal(t, authn.ProviderOIDC.String(), user.AuthProvider)
+	})
+	t.Run("KeepsSpacesInPassword", func(t *testing.T) {
+		useLdap(t, &ldapDirectory{passwords: map[string]string{"ldapspace": " secret 4 "}})
+
+		user, _, _, err := Auth(form.Login{Username: "ldapspace", Password: " secret 4 "}, nil, nil)
+
+		require.NoError(t, err)
+		assert.NotNil(t, user)
+	})
+	t.Run("RejectsWrongPassword", func(t *testing.T) {
+		useLdap(t, &ldapDirectory{passwords: map[string]string{"ldapwrong": "secret-5"}})
+
+		user, _, _, err := Auth(form.Login{Username: "ldapwrong", Password: "guess"}, nil, nil)
+
+		assert.Error(t, err)
+		assert.Nil(t, user)
+		assert.Nil(t, FindUserByExactName("ldapwrong"))
+	})
+	t.Run("LeavesLocalAccountAlone", func(t *testing.T) {
+		m := User{UserName: "ldaplocalonly", UserRole: acl.RoleAdmin.String(), AuthProvider: authn.ProviderLocal.String(), CanLogin: true}
+		require.NoError(t, m.Create())
+		require.NoError(t, m.SetPassword("local-password-6"))
+		useLdap(t, &ldapDirectory{passwords: map[string]string{"ldaplocalonly": "ldap-password-6"}})
+
+		_, _, _, err := Auth(form.Login{Username: "ldaplocalonly", Password: "ldap-password-6"}, nil, nil)
+
+		assert.Error(t, err)
+	})
+	t.Run("LeavesAppPasswordsToLocalAuth", func(t *testing.T) {
+		directory := &ldapDirectory{}
+		useLdap(t, directory)
+
+		assert.Nil(t, AuthLdap("ldapapp", "1234Ab-cdEFgh-IjKlmN-opQRst"))
+		assert.Zero(t, directory.binds)
+	})
+	t.Run("OffWithoutLdapUri", func(t *testing.T) {
+		directory := &ldapDirectory{passwords: map[string]string{"ldapoff": "secret-7"}}
+		useLdap(t, directory)
+		t.Setenv("PHOTOPRISM_LDAP_URI", "")
+
+		assert.Nil(t, AuthLdap("ldapoff", "secret-7"))
+		assert.Zero(t, directory.binds)
+	})
+}
diff --git a/internal/entity/auth_user_syncloud.go b/internal/entity/auth_user_syncloud.go
new file mode 100644
index 0000000..4742bd8
--- /dev/null
+++ b/internal/entity/auth_user_syncloud.go
@@ -0,0 +1,42 @@
+package entity
+
+import (
+	"github.com/photoprism/photoprism/internal/auth/acl"
+	"github.com/photoprism/photoprism/pkg/authn"
+)
+
+func LinkLdapUser(oidcUser User) error {
+	if oidcUser.UserName == "" || oidcUser.AuthID == "" || FindUser(oidcUser) != nil {
+		return nil
+	}
+
+	user := FindUserByName(oidcUser.UserName)
+
+	if user == nil || !user.IsUnlinkedLdap() {
+		return nil
+	}
+
+	user.SetProvider(authn.ProviderOIDC)
+	user.SetAuthID(oidcUser.AuthID, oidcUser.AuthIssuer)
+
+	return user.Updates(Values{
+		"AuthProvider": user.AuthProvider,
+		"AuthMethod":   user.AuthMethod,
+		"AuthID":       user.AuthID,
+		"AuthIssuer":   user.AuthIssuer,
+	})
+}
+
+func (m *User) IsUnlinkedLdap() bool {
+	return m.ID > 1 && (m.AuthProvider == "" || authn.ProviderType(m.AuthProvider).IsDefault()) && m.AuthID == "" && FindPassword(m.UserUID) == nil
+}
+
+func (m *User) IsLdapAccount() bool {
+	return authn.ProviderType(m.AuthProvider).IsOIDC() || m.IsUnlinkedLdap()
+}
+
+func (m *User) EnsureUserBasePath() {
+	if m.AclRole() == acl.RoleUser && m.BasePath == "" {
+		m.SetBasePath("~")
+	}
+}
