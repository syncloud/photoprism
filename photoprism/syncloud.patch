+func TestLinkLdapUser(t *testing.T) {
+	t.Run("LinksAccountCreatedByLdap", func(t *testing.T) {
+		m := User{UserName: "ldaplinked", UserRole: acl.RoleUser.String(), CanLogin: true}
+		require.NoError(t, m.Create())
+
+		require.NoError(t, LinkLdapUser(oidcLogin("ldaplinked", "sub-ldaplinked")))
+
+		found := FindUser(oidcLogin("ldaplinked", "sub-ldaplinked"))
+		require.NotNil(t, found)
+		assert.Equal(t, m.UserUID, found.UserUID)
+		assert.Equal(t, authn.ProviderOIDC.String(), found.AuthProvider)
+	})
+	t.Run("LinksAccountCreatedByOlderLdap", func(t *testing.T) {
+		m := User{UserName: "ldapolder", UserRole: acl.RoleAdmin.String(), AuthProvider: authn.ProviderDefault.String(), SuperAdmin: true, CanLogin: true}
+		require.NoError(t, m.Create())
+
+		require.NoError(t, LinkLdapUser(oidcLogin("ldapolder", "sub-ldapolder")))
+
+		found := FindUser(oidcLogin("ldapolder", "sub-ldapolder"))
+		require.NotNil(t, found)
+		assert.Equal(t, m.UserUID, found.UserUID)
+		assert.Equal(t, authn.ProviderOIDC.String(), found.AuthProvider)
+	})
+	t.Run("SkipsOlderAccountWithPassword", func(t *testing.T) {
+		m := User{UserName: "ldapolderpassword", UserRole: acl.RoleUser.String(), AuthProvider: authn.ProviderDefault.String(), CanLogin: true}
+		require.NoError(t, m.Create())
+		require.NoError(t, m.SetPassword("local-password-1"))
+
+		require.NoError(t, LinkLdapUser(oidcLogin("ldapolderpassword", "sub-ldapolderpassword")))
+
+		assert.Nil(t, FindUser(oidcLogin("ldapolderpassword", "sub-ldapolderpassword")))
+	})
+	t.Run("SkipsAccountWithPassword", func(t *testing.T) {
+		m := User{UserName: "ldappassword", UserRole: acl.RoleUser.String(), CanLogin: true}
+		require.NoError(t, m.Create())
+		require.NoError(t, m.SetPassword("local-password-1"))
+
+		require.NoError(t, LinkLdapUser(oidcLogin("ldappassword", "sub-ldappassword")))
+
+		assert.Nil(t, FindUser(oidcLogin("ldappassword", "sub-ldappassword")))
+	})
+	t.Run("SkipsAccountWithProvider", func(t *testing.T) {
+		m := User{UserName: "ldaplocal", UserRole: acl.RoleUser.String(), AuthProvider: authn.ProviderLocal.String(), CanLogin: true}
+		require.NoError(t, m.Create())
+
+		require.NoError(t, LinkLdapUser(oidcLogin("ldaplocal", "sub-ldaplocal")))
+
+		assert.Nil(t, FindUser(oidcLogin("ldaplocal", "sub-ldaplocal")))
+	})
+	t.Run("KeepsExistingLink", func(t *testing.T) {
+		m := User{UserName: "ldapsecond", UserRole: acl.RoleUser.String(), CanLogin: true}
+		require.NoError(t, m.Create())
+		require.NoError(t, LinkLdapUser(oidcLogin("ldapsecond", "sub-first")))
+
+		require.NoError(t, LinkLdapUser(oidcLogin("ldapsecond", "sub-second")))
+
+		assert.NotNil(t, FindUser(oidcLogin("ldapsecond", "sub-first")))
+		assert.Nil(t, FindUser(oidcLogin("ldapsecond", "sub-second")))
+	})
+	t.Run("SkipsDefaultAdmin", func(t *testing.T) {
+		assert.False(t, (&User{ID: 1, UserName: "admin"}).IsUnlinkedLdap())
+	})
+}
+
+func TestUser_EnsureUserBasePath(t *testing.T) {
+	t.Run("UserGetsOwnFolder", func(t *testing.T) {
+		m := User{UserName: "folderuser", UserRole: acl.RoleUser.String()}
+		m.EnsureUserBasePath()
+		assert.Equal(t, "users/folderuser", m.BasePath)
+	})
+	t.Run("KeepsExistingFolder", func(t *testing.T) {
+		m := User{UserName: "folderuser", UserRole: acl.RoleUser.String(), BasePath: "shared"}
+		m.EnsureUserBasePath()
+		assert.Equal(t, "shared", m.BasePath)
+	})
+	t.Run("AdminSeesEverything", func(t *testing.T) {
+		m := User{UserName: "folderadmin", UserRole: acl.RoleAdmin.String()}
+		m.EnsureUserBasePath()
+		assert.Equal(t, "", m.BasePath)
+	})
