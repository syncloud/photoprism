@@ -0,0 +1,56 @@
+package oidc
+
+import (
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestSocketTransport(t *testing.T) {
+	socket := filepath.Join(t.TempDir(), "auth.socket")
+	listener, err := net.Listen("unix", socket)
+	require.NoError(t, err)
+
+	server := &http.Server{Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = fmt.Fprintf(w, "socket %s %s %s", r.Host, r.Header.Get("X-Forwarded-Proto"), r.Header.Get("X-Forwarded-Host"))
+	})}
+	go func() { _ = server.Serve(listener) }()
+	defer server.Close()
+
+	network := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = fmt.Fprint(w, "network")
+	}))
+	defer network.Close()
+
+	client := &http.Client{Transport: NewSocketTransport(socket, "auth.example.com", http.DefaultTransport)}
+
+	t.Run("IssuerHostGoesThroughSocket", func(t *testing.T) {
+		resp, err := client.Get("https://auth.example.com/.well-known/openid-configuration")
+		require.NoError(t, err)
+		defer resp.Body.Close()
+		body, err := io.ReadAll(resp.Body)
+		require.NoError(t, err)
+		assert.Equal(t, "socket auth.example.com https auth.example.com", string(body))
+	})
+	t.Run("OtherHostsUseNetwork", func(t *testing.T) {
+		resp, err := client.Get(network.URL)
+		require.NoError(t, err)
+		defer resp.Body.Close()
+		body, err := io.ReadAll(resp.Body)
+		require.NoError(t, err)
+		assert.Equal(t, "network", string(body))
+	})
+	t.Run("HttpClientUsesSocketWhenConfigured", func(t *testing.T) {
+		t.Setenv("PHOTOPRISM_OIDC_SOCKET", socket)
+		t.Setenv("PHOTOPRISM_OIDC_URI", "https://auth.example.com")
+		assert.IsType(t, &SocketTransport{}, HttpClient(false).Transport)
+		assert.IsType(t, LoggingRoundTripper{}, HttpClient(true).Transport)
+	})
+}
